load_module modules/ngx_otel_module.so;

pid /tmp/nginx.pid;

events {
    worker_connections 1024;
}

http {
    # Map URIs to low-cardinality route patterns
    map $uri $otel_route {
        ~^/attributes/[^/]+\.html$  "/attributes/{business_domain}";
        ~^/services/[^/]+\.html$    "/services/{service_name}";
        ~^/index\.html$             "/index";
        ~^/$                        "/";
        default                     $uri;
    }

    otel_exporter {
        endpoint ${OTEL_COLLECTOR_HOST}:${OTEL_COLLECTOR_PORT_GRPC};
        interval 5s;
        batch_size 256;
        batch_count 2;
    }
    otel_trace on;
    otel_trace_context propagate;
    otel_service_name ${OTEL_SERVICE_NAME};
    otel_span_name "$request_method $otel_route";

    # Structured access log correlated to the request's trace/span (from
    # ngx_otel_module above), using OTel HTTP semantic-convention field
    # names, instead of nginx's default plain-text combined format. url.path
    # uses $uri (the actual request path), not $otel_route: the low-
    # cardinality template above is right for a span *name* (aggregation/
    # backend cost), but a log line should keep the real path - collapsing
    # every /attributes/*.html request to one templated string would make
    # the actual page requested unrecoverable from the log.
    log_format otel_json escape=json
        '{'
            '"timestamp":"$time_iso8601",'
            '"trace_id":"$otel_trace_id",'
            '"span_id":"$otel_span_id",'
            '"http.request.method":"$request_method",'
            '"url.path":"$uri",'
            '"http.response.status_code":$status,'
            '"http.response.body.size":$body_bytes_sent,'
            '"http.request.duration":$request_time,'
            '"network.protocol.version":"$server_protocol",'
            '"user_agent.original":"$http_user_agent"'
        '}';
    access_log /dev/stdout otel_json;

    include mime.types;
    sendfile on;
    server {
        listen ${TELEMETRY_DOCS_PORT};
        listen [::]:${TELEMETRY_DOCS_PORT};

        resolver 127.0.0.11;
        autoindex off;

        server_name _;
        server_tokens off;

        root /static;
        gzip_static on;

        # Don't trace static assets
        location ~* \.(css|js|png|jpg|jpeg|svg|ico|woff|woff2|ttf|eot|map|json|xml|gz)$ {
            otel_trace off;
            expires 1y;
            add_header Cache-Control "public, immutable";
        }

        location /assets/ {
            otel_trace off;
            expires 1y;
            add_header Cache-Control "public, immutable";
        }

        location /search/ {
            otel_trace off;
        }

        location /status {
            otel_trace off;
            stub_status on;
            # Inherits the http-level `access_log /dev/stdout otel_json;`
            # above - "on" is not a valid access_log argument (nginx only
            # recognizes "off" as a keyword; anything else is parsed as a
            # file path), so the previous `access_log on;` here silently
            # fell back to the default combined text format instead of
            # otel_json, and would have tried to write to a file literally
            # named "on".
            allow all;
        }
    }
}
